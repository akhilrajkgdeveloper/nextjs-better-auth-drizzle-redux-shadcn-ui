# Copy this file to .env and replace the placeholders with your own values.

# PostgreSQL connection used by the app and Drizzle migrations.
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Generate a random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# App URL. lib/auth.ts currently sets baseURL explicitly to localhost.
BETTER_AUTH_URL="http://localhost:3000"
